---

---

<div class="container flex flex-col gap-4">
  <h2 id="connected-banner" class="m-0 hidden">Connected!</h2>

  <button
    class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
    id="connect"
  >
    Connect
  </button>

  <div class="hidden flex flex-col gap-4" id="upload-container">
    <div
      class="hidden flex flex-col items-center justify-center gap-3"
      id="media-viewer"
    >
      <img
        src=""
        alt="Preview Image for user upload"
        id="preview-image"
        class="max-w-[240px] max-h-[320px] rounded border"
      />

      <video
        controls
        src=""
        id="preview-video"
        class="hidden max-w-[240px] max-h-[320px] rounded border"></video>
    </div>

    <div class="flex items-center justify-center w-full">
      <label
        for="file"
        id="drop-zone"
        class="flex flex-col items-center justify-center w-full h-32 p-4 border-2 border-dashed rounded-lg cursor-pointer bg-blue-300 border-black-300 hover:bg-blue-200 transition duration-300"
      >
        <div class="flex flex-col items-center justify-center pt-5 pb-6">
          <svg
            class="w-8 h-8 mb-4 text-black-500"
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 20 16"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2"
            ></path>
          </svg>

          <p class="mb-2 text-sm text-black-500">
            <span class="font-semibold">Click to upload</span> or drag and drop
          </p>

          <p class="text-xs text-black-500">MP4, GIF, PNG, JPG</p>
        </div>

        <input
          id="file"
          type="file"
          class="hidden"
          accept="image/png,image/*,video/*"
        />
      </label>
    </div>

    <button
      id="upload"
      class="mt-3 bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded"
    >
      Upload
    </button>

    <div
      id="summary"
      class="mt-4 rounded border border-gray-300 bg-gray-100 p-3 text-sm"
    >
      <h3 class="font-bold mb-2 m-0">Upload Summary</h3>

      <div class="grid grid-cols-2 gap-1">
        <span>Status:</span>
        <span id="summary-status">Idle</span>

        <span>File:</span>
        <span id="summary-file">-</span>

        <span>Progress:</span>
        <span id="summary-progress">0 / 0</span>
      </div>

      <div class="w-full bg-gray-300 rounded mt-3 h-3 overflow-hidden">
        <div
          id="summary-progress-bar"
          class="bg-blue-600 h-3 transition-all duration-200"
          style="width: 0%"
        >
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import * as ffmpeg from "@ffmpeg/ffmpeg";
  import { fetchFile } from "@ffmpeg/util";

  const mpegRef = new ffmpeg.FFmpeg();

  const SERVICE_UUID = "00000000-0000-0000-6473-5f696c666973";
  const DATA_CHAR_UUID = "00000000-0000-0200-6473-5f696c666973";

  const CATEGORY_FILE = 0x04;

  const FileCommand = {
    START_REQUEST: 0,
    START_RESPONSE: 1,
    FILE_SEND_START_REQUEST: 2,
    FILE_SEND_START_RESPONSE: 3,
    FILE_SEND_DATA_REQUEST: 4,
    FILE_SEND_DATA_RESPONSE: 5,
    FILE_SEND_END_REQUEST: 6,
    FILE_SEND_END_RESPONSE: 7,
    END_REQUEST: 8,
    END_RESPONSE: 9,
    LOSE_CHECK_REQUEST: 10,
    LOSE_CHECK_RESPONSE: 11,
    FILE_INFO_REQUEST: 13,
    FILE_INFO_RESPONSE: 14,
  };

  let device = null;
  let server = null;
  let dataChar = null;
  let ffmpegLoaded = false;

  const waiters = [];

  let reassembly = {
    category: null,
    expectedLen: null,
    buffer: [],
  };

  function setSummaryText(id, value) {
    const el = document.getElementById(id);

    if (el) {
      el.textContent = String(value);
    }
  }

  function setSummaryStatus(value) {
    setSummaryText("summary-status", value);
  }

  function setSummaryProgress(done, total) {
    setSummaryText("summary-progress", `${done} / ${total}`);

    const bar = document.getElementById("summary-progress-bar");

    if (bar) {
      const pct = total <= 0 ? 0 : Math.round((done / total) * 100);
      bar.style.width = `${pct}%`;
    }
  }

  function resetSummary() {
    setSummaryStatus("Idle");
    setSummaryText("summary-file", "-");
    setSummaryText("summary-raw-bytes", "-");
    setSummaryText("summary-aligned-bytes", "-");
    setSummaryText("summary-transfer-bytes", "-");
    setSummaryText("summary-crc", "-");
    setSummaryText("summary-chunks", "-");
    setSummaryProgress(0, 0);

    const log = document.getElementById("summary-log");

    if (log) {
      log.textContent = "";
    }
  }

  async function loadFFMPEG() {
    if (ffmpegLoaded) {
      return;
    }

    setSummaryStatus("Loading FFmpeg");

    mpegRef.on("log", ({ message }) => {
      console.log(message);
    });

    await mpegRef.load();

    ffmpegLoaded = true;

    setSummaryStatus("FFmpeg ready");
  }

  function resizeTo3x4Blob(image) {
    return new Promise((resolve, reject) => {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");

      if (!ctx) {
        reject(new Error("Could not get canvas context"));
        return;
      }

      const targetWidth = 240;
      const targetHeight = 320;

      canvas.width = targetWidth;
      canvas.height = targetHeight;

      const origWidth = image.naturalWidth;
      const origHeight = image.naturalHeight;

      let sourceWidth = origWidth;
      let sourceHeight = origHeight;
      let sourceX = 0;
      let sourceY = 0;

      const currentRatio = origWidth / origHeight;
      const targetRatio = 3 / 4;

      if (currentRatio > targetRatio) {
        sourceWidth = origHeight * targetRatio;
        sourceX = (origWidth - sourceWidth) / 2;
      } else {
        sourceHeight = origWidth / targetRatio;
        sourceY = (origHeight - sourceHeight) / 2;
      }

      ctx.fillStyle = "white";
      ctx.fillRect(0, 0, targetWidth, targetHeight);

      ctx.drawImage(
        image,
        sourceX,
        sourceY,
        sourceWidth,
        sourceHeight,
        0,
        0,
        targetWidth,
        targetHeight,
      );

      canvas.toBlob((blob) => {
        if (!blob) {
          reject(new Error("Failed to create resized image blob"));
          return;
        }

        resolve(blob);
      }, "image/png");
    });
  }

  function u16le(n) {
    return [n & 0xff, (n >> 8) & 0xff];
  }

  function u32le(n) {
    return [n & 0xff, (n >> 8) & 0xff, (n >> 16) & 0xff, (n >> 24) & 0xff];
  }

  function readU16le(bytes, offset = 0) {
    return bytes[offset] | (bytes[offset + 1] << 8);
  }

  function readU32le(bytes, offset = 0) {
    return (
      (bytes[offset] |
        (bytes[offset + 1] << 8) |
        (bytes[offset + 2] << 16) |
        (bytes[offset + 3] << 24)) >>>
      0
    );
  }

  function concatBytes(...arrays) {
    const len = arrays.reduce((n, a) => n + a.length, 0);
    const out = new Uint8Array(len);

    let offset = 0;

    for (const a of arrays) {
      out.set(a, offset);
      offset += a.length;
    }

    return out;
  }

  function encodeFrame(category, payload) {
    return concatBytes(
      new Uint8Array([category, 0x00, ...u16le(payload.length)]),
      payload,
    );
  }

  function encodeFileMessage(command, payload = new Uint8Array()) {
    const inner = concatBytes(
      new Uint8Array([...u16le(command), ...u16le(payload.length)]),
      payload,
    );

    return encodeFrame(CATEGORY_FILE, inner);
  }

  function splitFrame(frame, mtu = 512) {
    const chunkSize = mtu - 3 - 4;
    const category = frame[0];
    const payload = frame.slice(4);
    const totalPayloadLen = payload.length;

    if (frame.length <= chunkSize) {
      return [frame];
    }

    const chunks = [];

    for (let offset = 0; offset < payload.length; offset += chunkSize) {
      const part = payload.slice(offset, offset + chunkSize);

      if (offset === 0) {
        chunks.push(
          concatBytes(
            new Uint8Array([category, 0x01, ...u16le(totalPayloadLen)]),
            part,
          ),
        );
      } else if (offset + part.length < payload.length) {
        chunks.push(concatBytes(new Uint8Array([category, 0x02]), part));
      } else {
        chunks.push(concatBytes(new Uint8Array([category, 0x03]), part));
      }
    }

    return chunks;
  }

  function monicardCrc32(data) {
    let crc = 0xffffffff;
    const poly = 0x04c11db7;

    for (const b of data) {
      crc ^= (b << 24) >>> 0;

      for (let i = 0; i < 8; i++) {
        if (crc & 0x80000000) {
          crc = (((crc << 1) >>> 0) ^ poly) >>> 0;
        } else {
          crc = (crc << 1) >>> 0;
        }
      }
    }

    return crc >>> 0;
  }

  function prepareTransferBytes(raw) {
    const alignedLen = (raw.length + 3) & ~3;
    const padded = new Uint8Array(alignedLen);

    padded.set(raw);

    const crc = monicardCrc32(padded);
    const transfer = concatBytes(padded, new Uint8Array(u32le(crc)));

    return { transfer, alignedLen, crc };
  }

  function encodeStart(totalLength) {
    const payload = new Uint8Array([0x01, 0x00, 0x02, ...u32le(totalLength)]);

    return encodeFileMessage(FileCommand.START_REQUEST, payload);
  }

  function encodeFileInfo(packetCount) {
    return encodeFileMessage(
      FileCommand.FILE_INFO_REQUEST,
      new Uint8Array(u32le(packetCount)),
    );
  }

  function encodeFileSendStart(totalLength, filename) {
    const nameBytes = new TextEncoder().encode(filename);

    const payload = concatBytes(
      new Uint8Array([...u32le(totalLength), ...u16le(nameBytes.length)]),
      nameBytes,
    );

    return encodeFileMessage(FileCommand.FILE_SEND_START_REQUEST, payload);
  }

  function encodeFileData(index, chunk) {
    return encodeFileMessage(
      FileCommand.FILE_SEND_DATA_REQUEST,
      concatBytes(new Uint8Array(u32le(index)), chunk),
    );
  }

  function encodeFileSendEnd() {
    return encodeFileMessage(
      FileCommand.FILE_SEND_END_REQUEST,
      new Uint8Array([0x00, 0x00]),
    );
  }

  function encodeTransferEnd() {
    return encodeFileMessage(FileCommand.END_REQUEST);
  }

  function encodeLoseCheckResponse() {
    return encodeFileMessage(
      FileCommand.LOSE_CHECK_RESPONSE,
      new Uint8Array([0x00, 0x00]),
    );
  }

  function resetReassembly() {
    reassembly = {
      category: null,
      expectedLen: null,
      buffer: [],
    };
  }

  function reassemble(data) {
    const category = data[0];
    const type = data[1];

    if (type === 0) {
      return data;
    }

    if (type === 1) {
      reassembly.category = category;
      reassembly.expectedLen = readU16le(data, 2);
      reassembly.buffer = Array.from(data.slice(4));

      if (reassembly.buffer.length >= reassembly.expectedLen) {
        const payload = new Uint8Array(
          reassembly.buffer.slice(0, reassembly.expectedLen),
        );

        resetReassembly();

        return concatBytes(
          new Uint8Array([category, 0x00, ...u16le(payload.length)]),
          payload,
        );
      }

      return null;
    }

    if (type === 2 || type === 3) {
      if (reassembly.category !== category || reassembly.expectedLen === null) {
        resetReassembly();
        return null;
      }

      reassembly.buffer.push(...data.slice(2));

      if (type === 3) {
        const payload = new Uint8Array(
          reassembly.buffer.slice(0, reassembly.expectedLen),
        );

        resetReassembly();

        return concatBytes(
          new Uint8Array([category, 0x00, ...u16le(payload.length)]),
          payload,
        );
      }
    }

    return null;
  }

  function parseFileFrame(frame) {
    const category = frame[0];
    const payloadLen = readU16le(frame, 2);
    const payload = frame.slice(4, 4 + payloadLen);

    if (category !== CATEGORY_FILE || payload.length < 2) {
      return null;
    }

    const cmd = readU16le(payload, 0);
    const body = payload.slice(2);

    return { cmd, body };
  }

  async function onNotify(event) {
    const target = event.target;

    if (!target?.value) {
      return;
    }

    const data = new Uint8Array(target.value.buffer);
    const complete = reassemble(data);

    if (!complete) {
      return;
    }

    const parsed = parseFileFrame(complete);

    if (!parsed) {
      return;
    }

    console.log("[notify]", parsed.cmd, bytesToHex(parsed.body));

    if (parsed.cmd === FileCommand.LOSE_CHECK_REQUEST) {
      await sendFrame(encodeLoseCheckResponse(), "LOSE_CHECK_RESPONSE");
    }

    const waiterIndex = waiters.findIndex((w) => w.cmd === parsed.cmd);

    if (waiterIndex >= 0) {
      const waiter = waiters.splice(waiterIndex, 1)[0];
      waiter.resolve(parsed.body);
    }
  }

  function waitFor(cmd, timeoutMs = 10_000) {
    return new Promise((resolve, reject) => {
      const waiter = {
        cmd,
        resolve: (body) => {
          clearTimeout(timer);
          resolve(body);
        },
        reject,
      };

      const timer = window.setTimeout(() => {
        const idx = waiters.indexOf(waiter);

        if (idx >= 0) {
          waiters.splice(idx, 1);
        }

        reject(new Error(`Timeout waiting for cmd ${cmd}`));
      }, timeoutMs);

      waiters.push(waiter);
    });
  }

  async function sendFrame(frame, label, mtu = 512) {
    if (!dataChar) {
      throw new Error("Not connected");
    }

    const chunks = splitFrame(frame, mtu);

    console.log(`[write] ${label}: ${chunks.length} BLE writes`);

    for (const chunk of chunks) {
      if (chunk.length > 512) {
        throw new Error(`Web Bluetooth write too large: ${chunk.length} bytes`);
      }

      if ("writeValueWithoutResponse" in dataChar) {
        await dataChar.writeValueWithoutResponse(chunk);
      } else {
        await dataChar.writeValue(chunk);
      }

      await sleep(30);
    }
  }

  async function waitStatus(cmd, label, timeoutMs = 10_000) {
    const body = await waitFor(cmd, timeoutMs);
    const status = body.length >= 2 ? readU16le(body, 0) : null;

    console.log(`[status] ${label}`, status, bytesToHex(body));

    if (status !== null && status !== 0) {
      throw new Error(`${label} failed: status=${status}`);
    }

    return body;
  }

  async function waitDataAck(index) {
    const body = await waitFor(FileCommand.FILE_SEND_DATA_RESPONSE, 15_000);
    const marker = body.length >= 4 ? readU32le(body, 0) : null;
    const status = body.length >= 6 ? readU16le(body, 4) : 0;

    console.log(`[ack] index=${index} marker=${marker} status=${status}`);

    if (status !== 0) {
      throw new Error(`Chunk ${index} rejected`);
    }
  }

  async function sendAndWaitStatus(
    frame,
    writeLabel,
    expectedCmd,
    statusLabel,
    timeoutMs = 10_000,
  ) {
    const waiter = waitStatus(expectedCmd, statusLabel, timeoutMs);
    await sendFrame(frame, writeLabel);
    return await waiter;
  }

  async function sendAndWaitDataAck(frame, index) {
    const waiter = waitDataAck(index);
    await sendFrame(frame, `FILE_SEND_DATA_REQUEST[${index}]`);
    await waiter;
  }

  async function connect() {
    resetSummary();
    setSummaryStatus("Connecting");

    device = await navigator.bluetooth.requestDevice({
      filters: [{ namePrefix: "MoniCard" }],
      optionalServices: [SERVICE_UUID],
    });

    if (!device.gatt) {
      throw new Error("Device does not expose GATT");
    }

    server = await device.gatt.connect();

    const service = await server.getPrimaryService(SERVICE_UUID);
    dataChar = await service.getCharacteristic(DATA_CHAR_UUID);

    dataChar.addEventListener("characteristicvaluechanged", onNotify);
    await dataChar.startNotifications();

    document.getElementById("connect")?.classList.add("hidden");
    document.getElementById("connected-banner")?.classList.remove("hidden");
    document.getElementById("upload-container")?.classList.remove("hidden");

    setSummaryStatus("Connected");
  }

  async function upload(file) {
    resetSummary();
    setSummaryStatus("Preparing");

    const raw = new Uint8Array(await file.arrayBuffer());
    const { transfer, alignedLen, crc } = prepareTransferBytes(raw);

    const fileChunkSize = 10_240;
    const chunks = [];

    for (let i = 0; i < transfer.length; i += fileChunkSize) {
      chunks.push(transfer.slice(i, i + fileChunkSize));
    }

    const crcText = `0x${crc.toString(16).padStart(8, "0")}`;

    setSummaryText("summary-file", file.name);
    setSummaryProgress(0, chunks.length);

    setSummaryStatus("Starting transfer");

    await sendAndWaitStatus(
      encodeStart(transfer.length),
      "START_REQUEST",
      FileCommand.START_RESPONSE,
      "START_RESPONSE",
    );

    setSummaryStatus("Sending file info");

    await sendAndWaitStatus(
      encodeFileInfo(chunks.length),
      "FILE_INFO_REQUEST",
      FileCommand.FILE_INFO_RESPONSE,
      "FILE_INFO_RESPONSE",
    );

    setSummaryStatus("Sending file header");

    await sendAndWaitStatus(
      encodeFileSendStart(transfer.length, file.name),
      "FILE_SEND_START_REQUEST",
      FileCommand.FILE_SEND_START_RESPONSE,
      "FILE_SEND_START_RESPONSE",
    );

    setSummaryStatus("Uploading chunks");

    for (let i = 0; i < chunks.length; i++) {
      await sendAndWaitDataAck(encodeFileData(i, chunks[i]), i);

      setSummaryProgress(i + 1, chunks.length);

      await sleep(20);
    }

    setSummaryStatus("Finalizing");

    await sendAndWaitStatus(
      encodeFileSendEnd(),
      "FILE_SEND_END_REQUEST",
      FileCommand.FILE_SEND_END_RESPONSE,
      "FILE_SEND_END_RESPONSE",
      5_000,
    );

    await sendAndWaitStatus(
      encodeTransferEnd(),
      "END_REQUEST",
      FileCommand.END_RESPONSE,
      "END_RESPONSE",
      5_000,
    );

    setSummaryStatus("Complete");

    console.log("Upload complete");
  }

  async function transcodeToMJPEG(video) {
    await loadFFMPEG();

    const ffmpeg = mpegRef;

    setSummaryStatus("Transcoding video");

    try {
      await ffmpeg.deleteFile("input.mp4");
    } catch {}

    try {
      await ffmpeg.deleteFile(video.name);
    } catch {}

    await ffmpeg.writeFile("input.mp4", await fetchFile(video));

    await ffmpeg.exec([
      "-i",
      "input.mp4",

      "-t",
      "4",

      "-an",
      "-sn",
      "-dn",

      "-vf",
      "fps=10,scale=240:320,format=yuvj420p",

      "-c:v",
      "mjpeg",

      "-q:v",
      "26",

      //   "-f",
      //   "avi",

      video.name,
    ]);

    const data = await ffmpeg.readFile(video.name);

    const bytes = data instanceof Uint8Array ? data : new Uint8Array(data);

    const outFile = new File([bytes], video.name, {
      type: "video/x-msvideo",
    });

    try {
      await ffmpeg.deleteFile("input.mp4");
    } catch {}

    try {
      await ffmpeg.deleteFile(video.name);
    } catch {}

    return outFile;
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function bytesToHex(bytes) {
    return Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  function loadImage(src) {
    return new Promise((resolve, reject) => {
      const img = new Image();

      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error("Failed to load image"));

      img.src = src;
    });
  }

  function readFileAsDataURL(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();

      reader.onload = () => {
        if (typeof reader.result === "string") {
          resolve(reader.result);
        } else {
          reject(new Error("FileReader did not return a string data URL"));
        }
      };

      reader.onerror = () => reject(reader.error);

      reader.readAsDataURL(file);
    });
  }

  const connectButton = document.getElementById("connect");
  const uploadButton = document.getElementById("upload");
  const fileInput = document.getElementById("file");

  if (!connectButton || !uploadButton || !fileInput) {
    throw new Error("Missing #connect, #upload, or #file element");
  }

  connectButton.onclick = () => {
    connect().catch((err) => {
      setSummaryStatus("Connect failed");

      console.error(err);
    });
  };

  fileInput.onchange = async () => {
    const file = fileInput.files?.[0];

    if (!file) {
      alert("Choose an upload first");
      return;
    }

    const mediaViewer = document.getElementById("media-viewer");
    const previewImage = document.getElementById("preview-image");
    const previewVideo = document.getElementById("preview-video");

    try {
      mediaViewer?.classList.remove("hidden");

      if (file.type.includes("video")) {
        previewImage?.classList.add("hidden");
        previewVideo?.classList.remove("hidden");

        previewVideo.src = URL.createObjectURL(file);

        setSummaryStatus("Video selected");
      } else {
        previewVideo?.classList.add("hidden");
        previewImage?.classList.remove("hidden");

        const dataUrl = await readFileAsDataURL(file);
        const img = await loadImage(dataUrl);
        const blob = await resizeTo3x4Blob(img);

        previewImage.src = URL.createObjectURL(blob);

        setSummaryStatus("Image selected");
      }
    } catch (err) {
      setSummaryStatus("Preview failed");
      console.error("Preview failed:", err);
    }
  };

  uploadButton.onclick = async () => {
    const file = fileInput.files?.[0];

    if (!file) {
      alert("Choose an image or video first");
      return;
    }

    try {
      if (
        file.type.includes("video") ||
        file.name.toLowerCase().endsWith(".mp4")
      ) {
        const mjpegFile = await transcodeToMJPEG(file);
        await upload(mjpegFile);
      } else {
        const dataUrl = await readFileAsDataURL(file);
        const img = await loadImage(dataUrl);
        const resizedBlob = await resizeTo3x4Blob(img);

        const resizedFile = new File([resizedBlob], file.name, {
          type: file.type,
        });

        await upload(resizedFile);
      }

      console.log("done");
    } catch (err) {
      setSummaryStatus("Failed");
      console.error("Upload failed:", err);
    }
  };

  const dropZone = document.getElementById("drop-zone")!;

  window.addEventListener("drop", (e) => {
    if ([...e.dataTransfer.items].some((item) => item.kind === "file")) {
      e.preventDefault();
    }
  });

  dropZone.addEventListener("drop", (e) => {
    console.log(e);

    if (e.dataTransfer?.files.length > 0) {
      e.preventDefault();


      fileInput.files = e.dataTransfer?.files;
      fileInput.dispatchEvent(new Event("change", { bubbles: true }));
    }
  });

  dropZone.addEventListener("dragover", (e) => {

    const fileItems = [...e.dataTransfer.items].filter(
      (item) => item.kind === "file",
    );
    if (fileItems.length > 0) {
      e.preventDefault();
      if (fileItems.some((item) => item.type.startsWith("image/"))) {
        e.dataTransfer.dropEffect = "copy";
      } else {
        e.dataTransfer.dropEffect = "none";
      }
    }
  });

  window.addEventListener("dragover", (e) => {
    const fileItems = [...e.dataTransfer.items].filter(
      (item) => item.kind === "file",
    );
    if (fileItems.length > 0) {
      e.preventDefault();
      if (!dropZone.contains(e.target)) {
        e.dataTransfer.dropEffect = "none";
      }
    }
  });
</script>
