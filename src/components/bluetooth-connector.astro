---
import Tabs from "./tabs.astro";
import Tab from "./tab.astro";
import Upload from "./upload.astro";
import BusinessCards from "./business-cards.astro";
import Settings from "./settings.astro";
---

<div class="container flex flex-col gap-4 min-h-0">
  <h2 id="connected-banner" class="m-0 hidden">Connected!</h2>

  <button
    class="bg-blue-500 border-none hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
    id="connect"
  >
    Connect
  </button>

  <div id="tabs" class="hidden tabs-wrapper min-h-0 overflow-y-auto">
    <Tabs>
      <Tab label="Upload">
        <Upload />
      </Tab>

      <Tab label="Cards">
        <BusinessCards />
      </Tab>

      <Tab label="Settings">
        <Settings />
      </Tab>
    </Tabs>
  </div>
</div>

<script>
  import { bluetoothService } from "../services/bluetooth";

  const connectButton = document.getElementById("connect");
  const connectedBanner = document.getElementById("connected-banner");
  const tabs = document.getElementById("tabs");

  if (!connectButton) {
    throw new Error("Missing #connect element");
  }

  bluetoothService.on("connected", () => {
    connectButton.classList.add("hidden");
    connectedBanner?.classList.remove("hidden");
    tabs?.classList.remove("hidden");
  });

  bluetoothService.on("disconnected", () => {
    connectButton.classList.remove("hidden");
    connectedBanner?.classList.add("hidden");
    tabs?.classList.add("hidden");
  });

  bluetoothService.on("error", (err) => {
    console.error(err);
  });

  connectButton.onclick = () => {
    bluetoothService.connect().catch((err) => {
      console.error(err);
    });
  };
</script>