---
import Tabs from "./tabs.astro";
import Tab from "./tab.astro";
import Upload from './upload.astro'
import BusinessCards from './business-cards.astro'
---

<div class="container flex flex-col gap-4">
  <h2 id="connected-banner" class="m-0 hidden">Connected!</h2>

  <button
    class="bg-blue-500 border-none hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"
    id="connect"
  >
    Connect
  </button>

  <div id="tabs" class="hidden tabs-wrapper">
    <Tabs>
      <Tab label="Upload">
        <Upload />
      </Tab>
      <Tab label="Business Cards">
        <BusinessCards />
      </Tab>
      <Tab label="Settings">

      </Tab>
    </Tabs>
  </div>
</div>

<script>

  import { bluetoothService } from "../services/bluetooth";





  bluetoothService.on("connected", () => {
    document.getElementById("connect")?.classList.add("hidden");
    document.getElementById("connected-banner")?.classList.remove("hidden");
    document.getElementById("tabs")?.classList.remove("hidden");
  });

  bluetoothService.on("disconnected", () => {
    document.getElementById("connect")?.classList.remove("hidden");
    document.getElementById("connected-banner")?.classList.add("hidden");
    document.getElementById("tabs")?.classList.add("hidden");
  });




  bluetoothService.on("error", (err) => {
    console.error(err);
  });

  const connectButton = document.getElementById("connect");


  if (!connectButton) {
    throw new Error("Missing #connect element");
  }

  connectButton.onclick = () => {
 //   resetSummary();

    bluetoothService.connect().catch((err) => {
   //   setSummaryStatus("Connect failed");
      console.error(err);
    });
  };



</script>